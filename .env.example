# BrandSentry — environment variable NAMES only; DO NOT put real secrets here.
# Planning template. Separate these values into Vercel frontend and Railway backend.
# VITE_ values are bundled into browser code and MUST NOT contain secrets.

# FRONTEND / VERCEL (public configuration)
VITE_API_BASE_URL=https://your-railway-backend.example
VITE_FIREBASE_API_KEY=your-public-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# BACKEND / RAILWAY (private; set via protected platform environment)
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
# In local development, use sqlite:///./.data/db/brandsentry.sqlite
# In Railway runtime, with /data persistent volume: sqlite:////data/db/brandsentry.sqlite
DATABASE_URL=sqlite:///./.data/db/brandsentry.sqlite
UPLOAD_DIR=./.data/uploads
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_MODEL=
# If additional signing is used; backend-issued guest token should be random+hash-stored
GUEST_SESSION_SIGNING_KEY=
SESSION_TTL_HOURS=12
AI_GUEST_HOURLY_LIMIT=5
AI_GUEST_DAILY_LIMIT=12
AI_USER_HOURLY_LIMIT=20
AI_USER_DAILY_LIMIT=50
AI_GLOBAL_DAILY_CALL_LIMIT=100
AI_MAX_CONCURRENT=2
AI_REQUEST_TIMEOUT_SECONDS=25
AI_RESULT_CACHE_TTL_SECONDS=43200
MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=INFO

# PORT is supplied by Railway at runtime: do not commit/deploy a hardcoded value.
