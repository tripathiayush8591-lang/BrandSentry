# BrandSentry backend — environment variable NAMES only; never real secrets.
# Copy to backend/.env (git-ignored) for local overrides; unset values fall
# back to the defaults in app/config.py.

APP_ENV=development

# Local default. On Railway (Phase 4): mount a persistent volume at /data and
# use sqlite:////data/db/brandsentry.sqlite (four slashes = absolute path).
DATABASE_URL=sqlite:///./.data/db/brandsentry.sqlite

# Comma-separated explicit CORS allow-list. No wildcards. In production add
# the exact Vercel origins (incl. intended preview URLs).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Railway injects PORT at runtime. HOST is optional: unset means 127.0.0.1 in
# development and 0.0.0.0 in any other environment.
HOST=
PORT=8000

LOG_LEVEL=INFO

# Reserved for Phase 3+ (guideline file uploads on the persistent volume).
UPLOAD_DIR=./.data/uploads

# --- Phase 2A: Firebase Google sign-in (verification only; no Firestore) ----
# Fixed project for BrandSentry.
FIREBASE_PROJECT_ID=brandsentry-68d05
# Configure the Admin SDK with ONE of the following (or rely on platform ADC):
# Full service-account JSON injected as a single private variable (Railway
# recommended). NEVER a real value in this file or in git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Path to a service-account file on the deployment (never committed).
FIREBASE_SERVICE_ACCOUNT_FILE=

# --- Phase 2A: sessions / cookies -------------------------------------------
# Opaque server-side session lifetimes (hours).
USER_SESSION_TTL_HOURS=72
GUEST_SESSION_TTL_HOURS=4
# Cookie flags; unset = auto (no Secure + SameSite=Lax in development,
# Secure + SameSite=None on HTTPS deployments).
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=

# --- Phase 2A: guest abuse controls ------------------------------------------
# Max guest sessions per client IP per rolling hour (DB-backed).
GUEST_SESSIONS_PER_IP_PER_HOUR=10

# --- Phase 3A: Brand Knowledge Vault -----------------------------------------
# Upload/extraction limits and DB-backed per-actor rate limits. Values are
# configuration, never secrets; defaults live in app/config.py.
KNOWLEDGE_MAX_UPLOAD_BYTES=5242880
KNOWLEDGE_MAX_EXTRACTED_CHARS=200000
KNOWLEDGE_CHUNK_MAX_CHARS=1000
KNOWLEDGE_UPLOADS_PER_HOUR=30
KNOWLEDGE_SEARCHES_PER_HOUR=120
KNOWLEDGE_SEARCH_MAX_TOP_K=10

# --- Phase 3B: Gemini provider (backend-only; never exposed to frontend) -----
# Server-side secret. Unset => AI engine reports UNAVAILABLE and only
# deterministic checks run (honest partial results, never faked completion).
GEMINI_API_KEY=
# Verify availability/quota for the actual project before deployment.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_OUTPUT_TOKENS=2048
# Bounded retries for transient failures only (429/5xx); 0 = fail fast.
GEMINI_MAX_RETRIES=0

# --- Phase 3B: validation engine limits --------------------------------------
PROMPT_VERSION=2026-10-24.1
VALIDATION_MAX_CONTENT_CHARS=12000
VALIDATION_EVIDENCE_TOP_K=6
VALIDATION_MAX_FINDINGS=12
VALIDATION_CACHE_TTL_HOURS=12
VALIDATION_USER_PER_HOUR=20
VALIDATION_GUEST_PER_HOUR=5
VALIDATION_WORKSPACE_PER_HOUR=60
GEMINI_CALLS_PER_DAY=100
GEMINI_TOKENS_PER_DAY=500000
