# BrandSentry backend — environment variable NAMES only; never real secrets.
# Copy to backend/.env (git-ignored) for local overrides; unset values fall
# back to the defaults in app/config.py.

APP_ENV=development

# Local default. On Railway (Phase 4): mount a persistent volume at /data and
# use sqlite:////data/db/brandsentry.sqlite (four slashes = absolute path).
DATABASE_URL=sqlite:///./.data/db/brandsentry.sqlite

# Comma-separated explicit CORS allow-list. No wildcards.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Railway injects PORT at runtime. HOST is optional: unset means 127.0.0.1 in
# development and 0.0.0.0 in any other environment.
HOST=
PORT=8000

LOG_LEVEL=INFO

# Reserved for Phase 3+ (guideline file uploads on the persistent volume).
UPLOAD_DIR=./.data/uploads
