# BrandSentry Frontend Environment Variables

# Backend API base URL (FastAPI backend origin)
# Local development default: http://127.0.0.1:8000
# Production always uses relative /api URLs through frontend/vercel.json.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Use the SAME hostname for frontend and backend locally (127.0.0.1 on both).
# An empty VITE_API_BASE_URL also uses relative URLs in development.
# Public Firebase web configuration only; never put Admin credentials here.
VITE_FIREBASE_API_KEY=<firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<firebase-auth-domain>
VITE_FIREBASE_PROJECT_ID=<firebase-project-id>
VITE_FIREBASE_APP_ID=<firebase-web-app-id>
